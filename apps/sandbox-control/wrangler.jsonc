{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orygin-sandbox-control",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 20
    }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "Sandbox", "name": "Sandbox" },
      { "class_name": "ControlNonceStore", "name": "CONTROL_NONCES" }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["Sandbox", "ControlNonceStore"],
      "tag": "v1"
    }
  ],
  "vars": {
    "BACKUP_BUCKET_NAME": "orygin-workspace-backups",
    "CLOUDFLARE_ACCOUNT_ID": "2ead1748668417f67d184d93a3fd69ec"
  },
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "orygin-workspace-backups"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
