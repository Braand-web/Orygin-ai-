{
  "name": "@orygin-ai/dsh-web-search-orygin",
  "description": "Orygin-backed search provider (native web_search via the Anthropic-compatible API) for the Orygin web capability seam (ctx.web)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Braand-web/Orygin-ai-.git",
    "directory": "packages/web/web-search-orygin"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@orygin-ai/dsh-agent": "workspace:^",
    "@orygin-ai/dsh-credentials": "workspace:^",
    "@orygin-ai/dsh-launch-environment": "workspace:^",
    "@orygin-ai/dsh-invariants": "workspace:^",
    "@orygin-ai/dsh-session": "workspace:^",
    "@orygin-ai/dsh-web": "workspace:^",
    "@orygin-ai/cordis": "workspace:^",
    "@orygin-ai/dsh-settings": "workspace:^"
  },
  "dependencies": {
    "@orygin-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@orygin-ai/dsh-agent": "workspace:^",
    "@orygin-ai/dsh-credentials": "workspace:^",
    "@orygin-ai/dsh-credentials-local": "workspace:^",
    "@orygin-ai/dsh-launch-environment": "workspace:^",
    "@orygin-ai/dsh-invariants": "workspace:^",
    "@orygin-ai/dsh-session": "workspace:^",
    "@orygin-ai/dsh-web": "workspace:^",
    "@orygin-ai/cordis": "workspace:^",
    "@orygin-ai/dsh-settings": "workspace:^"
  }
}
