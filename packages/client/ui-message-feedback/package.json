{
  "name": "@orygin-ai/dsh-client-ui-message-feedback",
  "description": "Per-message feedback controls contributed to the assistant-message action strip, backed by the messageFeedback Host Remote",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Braand-web/Orygin-ai-.git",
    "directory": "packages/client/ui-message-feedback"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@orygin-ai/dsh-client-runtime",
        "@orygin-ai/dsh-api-remotes",
        "@orygin-ai/dsh-client-locale",
        "@orygin-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@orygin-ai/dsh-api-remotes": "workspace:^",
    "@orygin-ai/dsh-client-connection": "workspace:^",
    "@orygin-ai/dsh-client-locale": "workspace:^",
    "@orygin-ai/dsh-client-runtime": "workspace:^",
    "@orygin-ai/dsh-client-ui-conversation": "workspace:^",
    "@orygin-ai/dsh-invariants": "workspace:^",
    "@orygin-ai/dsh-message-feedback": "workspace:^",
    "@orygin-ai/dsh-typert-protocol": "workspace:^",
    "@orygin-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@orygin-ai/dsh-api-remotes": "workspace:^",
    "@orygin-ai/dsh-client-connection": "workspace:^",
    "@orygin-ai/dsh-client-locale": "workspace:^",
    "@orygin-ai/dsh-client-runtime": "workspace:^",
    "@orygin-ai/dsh-client-test-runtime": "workspace:^",
    "@orygin-ai/dsh-client-ui-conversation": "workspace:^",
    "@orygin-ai/dsh-client-ui-primitives": "workspace:^",
    "@orygin-ai/dsh-client-ui-slots": "workspace:^",
    "@orygin-ai/dsh-invariants": "workspace:^",
    "@orygin-ai/dsh-message-feedback": "workspace:^",
    "@orygin-ai/dsh-typert-protocol": "workspace:^",
    "@orygin-ai/cordis": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
